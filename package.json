{
  "name": "noter",
  "private": true,
  "version": "0.1.2",
  "description": "Personal notes app for Windows",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build && tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "npm run build && node scripts/release.mjs",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
